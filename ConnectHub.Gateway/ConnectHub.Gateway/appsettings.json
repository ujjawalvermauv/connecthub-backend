{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "message-route": {
        "ClusterId": "message-cluster",
        "Match": {
          "Path": "/api/messages/{**catch-all}"
        }
      },
      "room-route": {
        "ClusterId": "room-cluster",
        "Match": {
          "Path": "/api/rooms/{**catch-all}"
        }
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      },
      "media-route": {
        "ClusterId": "media-cluster",
        "Match": {
          "Path": "/api/media/{**catch-all}"
        }
      },
      "presence-route": {
        "ClusterId": "signalr-cluster",
        "Match": {
          "Path": "/api/presence/{**catch-all}"
        }
      },
      "signalr-route": {
        "ClusterId": "signalr-cluster",
        "Match": {
          "Path": "/hubs/{**catch-all}"
        }
      },
      "admin-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/admin/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-dest": {
            "Address": "http://localhost:5001/"
          }
        }
      },
      "message-cluster": {
        "Destinations": {
          "message-dest": {
            "Address": "http://localhost:5002/"
          }
        }
      },
      "room-cluster": {
        "Destinations": {
          "room-dest": {
            "Address": "http://localhost:5003/"
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification-dest": {
            "Address": "http://localhost:5076/"
          }
        }
      },
      "media-cluster": {
        "Destinations": {
          "media-dest": {
            "Address": "http://localhost:5078/"
          }
        }
      },
      "signalr-cluster": {
        "Destinations": {
          "signalr-dest": {
            "Address": "http://localhost:5003/"
          }
        }
      }
    }
  }
}